# Caddy config for the SimpleCISO marketing site.
# Caddy auto-issues and renews Let's Encrypt certs for any domain pointed at this host.
# Install: copy to /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`.

simpleciso.ai {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4321

	# Long-cache the logo / wordmark / favicon.
	@brand path /simpleciso-wordmark.png /simpleciso-logo.png /favicon.svg /apple-touch-icon.png /og-default.png
	header @brand Cache-Control "public, max-age=604800"

	# Self-hosted fonts — cache for a year.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
}

www.simpleciso.ai {
	redir https://simpleciso.ai{uri} permanent
}
