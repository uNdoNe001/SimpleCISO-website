---
import Layout from "../layouts/Layout.astro";

const interestFromQuery = Astro.url.searchParams.get("interest") ?? "demo";
const validInterests = ["vciso", "mssp", "internal", "demo", "other"];
const initialInterest = validInterests.includes(interestFromQuery) ? interestFromQuery : "demo";
---

<Layout
  title="Contact SimpleCISO — Request a demo"
  description="Request a SimpleCISO demo or ask about early access. Tell us a little about your program and we'll reply within one business day."
>
  <section class="container-tight pt-16 pb-8 max-w-3xl">
    <span class="chip">Contact</span>
    <h1 class="mt-4 text-4xl md:text-5xl font-extrabold tracking-tight">Let's talk.</h1>
    <p class="mt-5 text-lg text-[color:var(--color-fg-muted)]">
      Want a walkthrough, or wondering whether SimpleCISO fits how you run security? Send us a few
      details and we'll reply within one business day. SimpleCISO is in early access — we're
      onboarding partners now.
    </p>
  </section>

  <section class="container-tight pb-20 grid gap-8 lg:grid-cols-3 items-start">
    <!-- FORM -->
    <form id="contact-form" class="card p-7 lg:col-span-2 space-y-4" novalidate>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="block text-sm font-medium">Name</span>
          <input type="text" name="name" required autocomplete="name" maxlength="200" class="form-input" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium">Work email</span>
          <input type="email" name="email" required autocomplete="email" class="form-input" />
        </label>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="block text-sm font-medium">Company <span class="text-[color:var(--color-fg-dim)] font-normal">(optional)</span></span>
          <input type="text" name="company" autocomplete="organization" maxlength="200" class="form-input" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium">What describes you best?</span>
          <select name="interest" class="form-select">
            <option value="vciso" selected={initialInterest === "vciso"}>Fractional / virtual CISO</option>
            <option value="mssp" selected={initialInterest === "mssp"}>MSSP / security partner</option>
            <option value="internal" selected={initialInterest === "internal"}>Internal security team</option>
            <option value="demo" selected={initialInterest === "demo"}>Just want a demo</option>
            <option value="other" selected={initialInterest === "other"}>Something else</option>
          </select>
        </label>
      </div>

      <label class="block">
        <span class="block text-sm font-medium">Message <span class="text-[color:var(--color-fg-dim)] font-normal">(optional)</span></span>
        <textarea name="message" maxlength="5000" class="form-textarea" placeholder="How many organizations do you manage? Which frameworks matter to you? What are you hoping to replace?"></textarea>
      </label>

      <!-- Honeypot: real users never fill this -->
      <div aria-hidden="true" style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <input type="hidden" name="source" value="contact" />

      <div class="flex items-center gap-4 pt-1">
        <button type="submit" id="submit-btn" class="btn-primary">Send message</button>
        <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
      </div>
      <p class="text-xs text-[color:var(--color-fg-dim)] leading-relaxed">
        By submitting, you agree we may contact you about SimpleCISO. We don't sell your data. See our
        <a href="/privacy" class="underline underline-offset-2 decoration-[color:var(--color-border-strong)] hover:text-[color:var(--color-fg)]">privacy notice</a>.
      </p>
    </form>

    <!-- SIDEBAR -->
    <aside class="space-y-4">
      <div class="card p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[color:var(--color-fg-dim)]">Prefer email?</h2>
        <a href="mailto:info@simpleciso.ai" class="mt-2 inline-block text-[color:var(--color-brand-blue)] font-medium hover:underline underline-offset-4">info@simpleciso.ai</a>
        <p class="mt-3 text-sm text-[color:var(--color-fg-muted)] leading-relaxed">We read every message and reply within one business day.</p>
      </div>
      <div class="card p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[color:var(--color-fg-dim)]">On a demo you'll see</h2>
        <ul class="mt-3 space-y-2 text-sm text-[color:var(--color-fg-muted)]">
          <li class="flex gap-2"><span class="text-[color:var(--color-brand-green)]">✓</span> The assessment-to-evidence lifecycle</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-brand-green)]">✓</span> Multi-client portfolio &amp; tenant isolation</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-brand-green)]">✓</span> The human approval gate in action</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-brand-green)]">✓</span> How SimpleSec findings flow in</li>
        </ul>
      </div>
      <div class="card p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[color:var(--color-fg-dim)]">Part of Summit Cyber</h2>
        <p class="mt-3 text-sm text-[color:var(--color-fg-muted)] leading-relaxed">
          Already using <a href="https://simplesec.ai" class="text-[color:var(--color-brand-blue)] hover:underline underline-offset-4">SimpleSec</a> for testing?
          Mention it — your findings can flow straight into SimpleCISO.
        </p>
      </div>
    </aside>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status");
  const btn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function setStatus(msg: string, kind: "ok" | "err" | "info") {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.style.color =
      kind === "ok"
        ? "var(--color-brand-green)"
        : kind === "err"
          ? "var(--color-danger)"
          : "var(--color-fg-muted)";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !btn) return;

    const fd = new FormData(form);
    const email = String(fd.get("email") ?? "").trim();
    const name = String(fd.get("name") ?? "").trim();
    if (!name) return setStatus("Please add your name.", "err");
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return setStatus("Please add a valid email.", "err");

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = "Sending…";
    setStatus("", "info");

    const payload = {
      name,
      email,
      company: String(fd.get("company") ?? "").trim(),
      interest: String(fd.get("interest") ?? "demo"),
      message: String(fd.get("message") ?? "").trim(),
      website: String(fd.get("website") ?? ""),
      source: "contact",
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.reset();
        setStatus("Thanks — we'll be in touch within one business day.", "ok");
      } else {
        setStatus(data.error || "Something went wrong. Please email info@simpleciso.ai.", "err");
      }
    } catch {
      setStatus("Network error. Please email info@simpleciso.ai.", "err");
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });
</script>
