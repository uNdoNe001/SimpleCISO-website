---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- HERO -->
  <section class="container-tight pt-16 md:pt-24 pb-10">
    <div class="hero-grid grid lg:grid-cols-2 gap-12 items-center" style="grid-template-columns: 1fr 1.05fr;">
      <div>
        <span class="chip">CISO work — simplified</span>
        <h1 class="mt-5 text-4xl md:text-[52px] font-extrabold tracking-tight leading-[1.05]">
          Run a real security program —
          <span class="text-[color:var(--color-brand-blue)]">without</span>
          <span class="text-[color:var(--color-brand-green)]"> drowning in it.</span>
        </h1>
        <p class="mt-6 text-lg text-[color:var(--color-fg-muted)] max-w-[54ch]">
          SimpleCISO turns technical findings and organizational information into a managed
          security program. AI does the repetitive work — assessments, mapping, drafting,
          follow-ups — while a qualified human stays accountable for every material decision.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/contact" class="btn-primary">Request a demo</a>
          <a href="/platform" class="btn-ghost">See the platform</a>
        </div>

        <div class="mt-8 flex flex-wrap gap-2.5">
          <span class="vchip"><span class="d"></span> Multi-tenant by design</span>
          <span class="vchip"><span class="d"></span> NIST CSF · CIS · ISO 27001 · PCI DSS</span>
          <span class="vchip"><span class="d"></span> Human-gated AI</span>
        </div>
      </div>

      <!-- Product dashboard mock -->
      <div class="console">
        <div class="con-chrome">
          <span class="con-dots"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></span>
          <span class="con-tab">simpleciso.ai/overview — Northwind Logistics</span>
          <span class="con-live"><span class="d"></span> LIVE</span>
        </div>
        <div class="con-body">
          <div class="dash-stats">
            <div class="dash-stat"><div class="dash-stat-label">Material risks</div><div class="dash-stat-value is-danger">7</div></div>
            <div class="dash-stat"><div class="dash-stat-label">Tasks overdue</div><div class="dash-stat-value is-warn">3</div></div>
            <div class="dash-stat"><div class="dash-stat-label">Evidence coverage</div><div class="dash-stat-value is-ok">68%</div></div>
            <div class="dash-stat"><div class="dash-stat-label">Next review</div><div class="dash-stat-value">12d</div></div>
          </div>

          <div class="dash-row">
            <div class="dash-panel">
              <div class="dash-panel-title">Open risk by severity</div>
              <div class="dash-donut-wrap">
                <div class="dash-donut"></div>
                <div class="dash-donut-legend">
                  <span class="dash-legend-row"><span class="dash-legend-dot" style="background:var(--color-danger)"></span> Critical · 2</span>
                  <span class="dash-legend-row"><span class="dash-legend-dot" style="background:var(--color-warning)"></span> High · 5</span>
                  <span class="dash-legend-row"><span class="dash-legend-dot" style="background:var(--color-brand-blue)"></span> Medium · 9</span>
                  <span class="dash-legend-row"><span class="dash-legend-dot" style="background:var(--color-fg-dim)"></span> Low · 6</span>
                </div>
              </div>
            </div>
            <div class="dash-panel">
              <div class="dash-panel-title">NIST CSF 2.0 readiness</div>
              <div class="dash-bars">
                <div class="dash-barwrap"><div class="dash-bar is-ok" style="height:78%"></div><span class="dash-barlabel">GV</span></div>
                <div class="dash-barwrap"><div class="dash-bar" style="height:64%"></div><span class="dash-barlabel">ID</span></div>
                <div class="dash-barwrap"><div class="dash-bar" style="height:52%"></div><span class="dash-barlabel">PR</span></div>
                <div class="dash-barwrap"><div class="dash-bar" style="height:41%"></div><span class="dash-barlabel">DE</span></div>
                <div class="dash-barwrap"><div class="dash-bar" style="height:58%"></div><span class="dash-barlabel">RS</span></div>
                <div class="dash-barwrap"><div class="dash-bar" style="height:33%"></div><span class="dash-barlabel">RC</span></div>
              </div>
            </div>
          </div>

          <div class="dash-list">
            <div class="dash-item"><span class="dash-sev crit">Crit</span><span>Unmanaged admin access on finance app</span><span class="dash-status gate">Needs sign-off</span></div>
            <div class="dash-item"><span class="dash-sev high">High</span><span>MFA gaps — mapped from SimpleSec finding #1182</span><span class="dash-owner">a.rivera</span></div>
            <div class="dash-item"><span class="dash-sev med">Med</span><span>Backup restore test evidence expiring</span><span class="dash-status ok">On track</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST / POSITIONING STRIP -->
  <section class="container-tight">
    <div class="card px-6 py-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-center">
      <span class="eyebrow">Part of the Summit Cyber stack</span>
      <span class="text-sm text-[color:var(--color-fg-muted)]"><b class="text-[color:var(--color-fg)]">SimpleSec</b> finds &amp; validates the technical risk</span>
      <span class="text-[color:var(--color-fg-dim)]">→</span>
      <span class="text-sm text-[color:var(--color-fg-muted)]"><b class="text-[color:var(--color-fg)]">SimpleCISO</b> turns it into a governed program</span>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="container-tight blk">
    <div class="sec-head center">
      <span class="eyebrow">The gap</span>
      <h2>Findings are easy. A <span class="text-[color:var(--color-brand-blue)]">program</span> is hard.</h2>
      <p>Scanners and pentests produce findings all day. Turning them into owned risks, prioritized
        work, documented decisions, and evidence an auditor will accept is the part that eats a
        CISO's week — and the part most teams never finish.</p>
    </div>
    <div class="tools-grid">
      <div class="tcard">
        <h3><span class="ti">◇</span> Scattered inputs</h3>
        <p>Spreadsheets, Slack threads, vendor portals, and PDF reports that never roll up into one defensible picture of where you stand.</p>
      </div>
      <div class="tcard">
        <h3><span class="ti">◷</span> Work that stalls</h3>
        <p>Gaps get noted but never become owned, dated tasks. Risk acceptance lives in someone's memory instead of a signed record.</p>
      </div>
      <div class="tcard">
        <h3><span class="ti">◎</span> Evidence you can't find</h3>
        <p>When the audit or the board asks, you're reconstructing months of activity from scratch — and hoping nothing expired.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="container-tight blk" style="padding-top:0" id="how">
    <div class="sec-head">
      <span class="eyebrow">How it works</span>
      <h2>Assessment to action — one governed lifecycle.</h2>
      <p>SimpleCISO runs the whole loop, and puts a human gate on every step that carries liability.</p>
    </div>
    <div class="steps">
      <div class="step">
        <span class="sn">01</span>
        <h3>Assess</h3>
        <p>Plain-language assessments against a framework produce a deterministic, explainable score — no black-box number.</p>
        <div class="tools"><span class="tag">NIST CSF 2.0</span><span class="tag">CIS</span></div>
      </div>
      <div class="step">
        <span class="sn">02</span>
        <h3>Prioritize</h3>
        <p>Gaps and imported findings become risk <em>candidates</em>. A human accepts, owns, or defers each one — nothing auto-closes.</p>
        <div class="tools"><span class="tag">risk register</span><span class="tag">30/60/90</span></div>
      </div>
      <div class="step">
        <span class="sn">03</span>
        <h3>Execute</h3>
        <p>Owned tasks with due dates, AI-drafted remediation guidance, and follow-ups that don't fall through the cracks.</p>
        <div class="tools"><span class="tag">tasks</span><span class="tag">AI drafts</span></div>
      </div>
      <div class="step">
        <span class="sn">04</span>
        <h3>Prove</h3>
        <p>Evidence vault with adequacy review and point-in-time snapshots — board and audit reports in a click.</p>
        <div class="tools"><span class="tag">evidence</span><span class="tag">reports</span></div>
      </div>
    </div>
  </section>

  <!-- GOVERNANCE BAND -->
  <section class="container-tight blk" style="padding-top:0" id="governance">
    <div class="band">
      <div class="split">
        <div>
          <span class="chip chip-green">The guardrail</span>
          <h2 class="mt-4 text-3xl md:text-[34px] font-extrabold tracking-tight leading-tight">AI never silently decides.</h2>
          <p class="mt-4 text-[color:var(--color-fg-muted)] text-[15.5px] leading-relaxed">
            Risk acceptance, evidence sufficiency, and anything you publish are human-gated. AI
            produces <strong class="text-[color:var(--color-fg)]">drafts behind approval</strong> and does
            the repetitive work — it never closes a control or accepts a risk on its own. Every
            material action is attributable to a person, with an audit trail.
          </p>
          <p class="mt-4 text-[color:var(--color-fg-muted)] text-[15.5px] leading-relaxed">
            We report <strong class="text-[color:var(--color-fg)]">readiness and evidence coverage</strong>,
            never "compliant" or "certified." That discipline is deliberate — it's a liability firewall
            you can stand behind.
          </p>
        </div>
        <div>
          <div class="dash-panel-title">Approval gate — pending decisions</div>
          <div class="evid">
            <div class="e"><div class="top"><span>Risk accept</span><span class="dec gate">Gate</span></div><p class="mt-2 text-[color:var(--color-fg-dim)]">Legacy VPN exception</p></div>
            <div class="e"><div class="top"><span>Evidence</span><span class="dec warn">Review</span></div><p class="mt-2 text-[color:var(--color-fg-dim)]">Access review Q3</p></div>
            <div class="e"><div class="top"><span>Control</span><span class="dec pass">Signed</span></div><p class="mt-2 text-[color:var(--color-fg-dim)]">Logging enabled</p></div>
            <div class="e"><div class="top"><span>Publish</span><span class="dec gate">Gate</span></div><p class="mt-2 text-[color:var(--color-fg-dim)]">Board report v4</p></div>
          </div>
          <p class="mt-4 text-xs font-mono text-[color:var(--color-fg-dim)]">Every row is attributable to a named human.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="container-tight blk" style="padding-top:0">
    <div class="sec-head">
      <span class="eyebrow">Who it's for</span>
      <h2>Built for the people who carry the program.</h2>
    </div>
    <div class="personas">
      <div class="pcard">
        <div class="pt">Fractional &amp; virtual CISOs</div>
        <div class="pd">Run many clients from one portfolio. Each organization is fully isolated — no spreadsheet-per-client, no cross-tenant leakage. See who needs attention first, in one view.</div>
      </div>
      <div class="pcard">
        <div class="pt">MSSPs &amp; security partners</div>
        <div class="pd">Deliver governance as a service on top of the testing you already do. SimpleSec findings flow in as risk candidates; SimpleCISO turns them into a managed program per client.</div>
      </div>
      <div class="pcard">
        <div class="pt">Internal security leaders</div>
        <div class="pd">One defensible system of record for assessments, risk, evidence, and board reporting — instead of a drawer full of point tools and stale spreadsheets.</div>
      </div>
    </div>
  </section>

  <!-- FRAMEWORKS -->
  <section class="container-tight blk" style="padding-top:0" id="frameworks">
    <div class="split">
      <div>
        <span class="eyebrow">Frameworks</span>
        <h2 class="mt-3 text-3xl md:text-[34px] font-extrabold tracking-tight leading-tight">Map once. Reuse everywhere.</h2>
        <p class="mt-4 text-[color:var(--color-fg-muted)] text-[15.5px] leading-relaxed">
          Assess against a canonical control model and reuse the work across frameworks. NIST CSF 2.0
          and CIS are built in; ISO/IEC 27001:2022 and PCI DSS ship as licensed catalogs with full
          provenance. Evidence collected for one maps to the others.
        </p>
        <div class="fw-row">
          <span class="fw">NIST CSF 2.0 <span class="st live">Built in</span></span>
          <span class="fw">CIS Controls <span class="st live">Built in</span></span>
          <span class="fw">ISO/IEC 27001 <span class="st soon">Licensed</span></span>
          <span class="fw">PCI DSS <span class="st soon">Licensed</span></span>
        </div>
      </div>
      <div class="card p-6">
        <div class="dash-panel-title">Control — one model, many frameworks</div>
        <div class="feat-list">
          <div class="feat"><span class="fi">✓</span><div><h4>Access control — privileged accounts</h4><p>NIST PR.AA · CIS 5/6 · ISO A.5.15 · PCI 7</p></div></div>
          <div class="feat"><span class="fi">✓</span><div><h4>Logging &amp; monitoring</h4><p>NIST DE.CM · CIS 8 · ISO A.8.15 · PCI 10</p></div></div>
          <div class="feat"><span class="fi">✓</span><div><h4>Backup &amp; recovery</h4><p>NIST RC.RP · CIS 11 · ISO A.8.13 · PCI 12</p></div></div>
        </div>
        <p class="mt-5 text-xs font-mono text-[color:var(--color-fg-dim)]">Readiness &amp; evidence coverage — not a certification claim.</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="container-tight pb-24">
    <div class="finalcta">
      <span class="chip">Early access</span>
      <h2 class="mt-4">See your program in one place.</h2>
      <p>SimpleCISO is onboarding early partners now. Book a walkthrough and we'll show you the
        assessment-to-evidence lifecycle on your own frameworks.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact" class="btn-primary">Request a demo</a>
        <a href="/platform" class="btn-ghost">Explore the platform</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Reveal-on-scroll
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -8% 0px" }
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
</script>
