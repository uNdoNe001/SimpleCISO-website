# SimpleCISO website — contact form email (nodemailer over SMTP).
# Copy to .env.production on the server (mode 600, owned by the service user).
# These are NOT committed. The contact endpoint (/api/contact) sends two emails
# per submission: a notification to the team and an acknowledgement to the sender.

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-gmail@summitcyber.io
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=SimpleCISO <your-sending-gmail@summitcyber.io>

# Where contact submissions are delivered.
CONTACT_NOTIFY_TO=info@simpleciso.ai
